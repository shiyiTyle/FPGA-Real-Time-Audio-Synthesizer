//Created Time: Wed 10 21 15:32:25 2026

// I2S -> PCM5102 DAC 模块（接 Dock 排针）
IO_LOC "i2s_mclk" F5;
IO_PORT "i2s_mclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "i2s_data" H8;
IO_PORT "i2s_data" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "i2s_lrclk" H5;
IO_PORT "i2s_lrclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "i2s_bclk" G7;
IO_PORT "i2s_bclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// ADS1115 I2C（FSR 压力->音高弯音；SDA 开漏，模组内置 10K 上拉，VCC 必须 3.3V）
IO_LOC "ads_scl" A11;
IO_PORT "ads_scl" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "ads_sda" E11;
IO_PORT "ads_sda" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// TTP229 电容触摸板（INPUT_SRC=1 时启用）：SCL 由 FPGA 驱动，SDA 输入
IO_LOC "tp_scl" L2;
IO_PORT "tp_scl" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tp_sda" K1;
IO_PORT "tp_sda" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// 延迟测量调试脚：任一音符触发=1（接示波器 CH1 测总延迟，可不接）
IO_LOC "dbg_lat" G5;
IO_PORT "dbg_lat" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// 4x4 矩阵键盘：行 R1~R4（扫描输出，低有效，空闲高阻）
// 实测对应：丝印第1行(S1~S4)=D10，第2行(S5~S8)=B10，
//           第3行(S9~S12)=G10，第4行(S13~S16)=C10
IO_LOC "kbd_row[0]" D10;
IO_PORT "kbd_row[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "kbd_row[1]" B10;
IO_PORT "kbd_row[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "kbd_row[2]" G10;
IO_PORT "kbd_row[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "kbd_row[3]" C10;
IO_PORT "kbd_row[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// 4x4 矩阵键盘：列 C1~C4（输入，内部上拉，按下=低）
// 实测对应：丝印第1列(S1/S5/S9/S13)=G11，向右依次 D11、B11、C11
IO_LOC "kbd_col[0]" G11;
IO_PORT "kbd_col[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "kbd_col[1]" D11;
IO_PORT "kbd_col[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "kbd_col[2]" B11;
IO_PORT "kbd_col[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "kbd_col[3]" C11;
IO_PORT "kbd_col[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// 核心板按键 S1（按下=1，需内部下拉）-> 左声道 C5
IO_LOC "key_s1" H11;
IO_PORT "key_s1" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
// 核心板按键 S2（按下=1，需内部下拉）-> 右声道 E5
IO_LOC "key_s2" H10;
IO_PORT "key_s2" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
// ST7789 240x240 IPS 屏（SPI mode0 / 12.5MHz），接顶部 40 针排针最右端 3 列
//   上排从右往左：K1(9) L2(4) J4(3) G2(4) L4(5)... -> J4=RES G2=SDA L4=SCL
//   下排从右往左：K2 L1 K4(3) G1(4) L3(5) 5V(6)      -> K4=CS  G1=DC
//   注意：L3 紧邻下排 5V 孔，已刻意弃用留作缓冲，切勿接到 5V
//   GND 取顶部排针 GND 孔；VCC 3V3 从底部空闲 3V3 孔取（屏不可接 5V）
IO_LOC "lcd_scl" L4;
IO_PORT "lcd_scl" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "lcd_sda" G2;
IO_PORT "lcd_sda" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "lcd_res" J4;
IO_PORT "lcd_res" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "lcd_dc" G1;
IO_PORT "lcd_dc" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "lcd_cs" K4;
IO_PORT "lcd_cs" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// 板载 50MHz 晶振
IO_LOC "sys_clk" E2;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
